# ChatGPT Advertiser API key from Ads Manager > Settings
# See https://developers.openai.com/ads/api-reference/authentication
OPENAI_ADS_API_KEY=sk-ads-...

# Alias also accepted (fallback if OPENAI_ADS_API_KEY is not set)
# CHATGPT_ADS_API_KEY=sk-ads-...

# Optional: default ad account ID (also pass per-tool as ad_account_id for multi-account)
# OPENAI_AD_ACCOUNT_ID=adacct_123

# Optional: override API base URL (default https://api.ads.openai.com/v1)
# OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
